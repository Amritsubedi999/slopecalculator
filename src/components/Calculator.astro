---
import SlopeDiagram from './SlopeDiagram.astro';
---

<section class="w-full" aria-label="Slope Calculator Engine">
  <!-- Screen reader announcer for live updates and clipboard actions -->
  <div id="calc-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>

  <!-- Calculator Container with crisp 1px borders -->
  <div class="border border-[var(--border-structural)] bg-[var(--surface-card)]">
    <!-- Top Control Bar: Mode Tabs & Precision Selector -->
    <div class="border-b border-[var(--border-structural)] bg-[var(--surface-muted)] flex flex-col md:flex-row md:items-center justify-between gap-3 p-3">
      <!-- Accessible Tablist -->
      <div
        class="inline-flex flex-wrap items-center gap-1 border border-[var(--border-structural)] bg-[var(--surface-card)] p-1 text-xs font-mono"
        role="tablist"
        aria-label="Slope Calculation Method"
      >
        <button
          type="button"
          id="tab-tp"
          role="tab"
          aria-selected="true"
          aria-controls="panel-tp"
          data-tab-type="twopoints"
          class="px-3 py-1.5 font-semibold transition-colors border border-[var(--text-primary)] bg-[var(--surface-card)] text-[var(--text-primary)]"
        >
          1. Two Points (X, Y)
        </button>
        <button
          type="button"
          id="tab-rr"
          role="tab"
          aria-selected="false"
          aria-controls="panel-rr"
          data-tab-type="riserun"
          tabindex="-1"
          class="px-3 py-1.5 transition-colors border border-transparent text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
        >
          2. Rise & Run
        </button>
        <button
          type="button"
          id="tab-ag"
          role="tab"
          aria-selected="false"
          aria-controls="panel-ag"
          data-tab-type="anglegrade"
          tabindex="-1"
          class="px-3 py-1.5 transition-colors border border-transparent text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
        >
          3. Angle / Grade
        </button>
      </div>

      <!-- Precision Selector -->
      <div class="flex items-center gap-2 text-xs font-mono self-end md:self-auto">
        <label for="calc-precision" class="text-[var(--text-secondary)] whitespace-nowrap">
          DECIMALS:
        </label>
        <select
          id="calc-precision"
          class="border border-[var(--border-structural)] bg-[var(--surface-card)] text-[var(--text-primary)] px-2 py-1 text-xs font-mono focus:outline-none focus:border-[var(--text-primary)]"
          aria-label="Display decimal precision"
        >
          <option value="2">2 places</option>
          <option value="3">3 places</option>
          <option value="4" selected>4 places (default)</option>
          <option value="6">6 places</option>
          <option value="8">8 places</option>
        </select>
      </div>
    </div>

    <!-- Main Workspace Grid: Controls & Outputs on Left, Diagram on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-[var(--border-structural)]">
      <!-- Left Column: Inputs & Results (7 cols on desktop) -->
      <div class="lg:col-span-7 p-4 sm:p-6 space-y-6">
        <!-- TAB PANEL 1: TWO POINTS -->
        <div
          id="panel-tp"
          role="tabpanel"
          aria-labelledby="tab-tp"
          class="space-y-6"
        >
          <div>
            <h3 class="text-xs font-mono uppercase tracking-wider text-[var(--text-secondary)] mb-3">
              Coordinates: Line segment from P₁ to P₂
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Point 1 (X1, Y1) -->
              <div class="border border-[var(--border-structural)] p-3 bg-[var(--surface-muted)] space-y-2">
                <div class="text-[11px] font-mono font-semibold text-[var(--text-primary)]">
                  POINT 1 (P₁)
                </div>
                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label for="tp-x1" class="block text-[10px] font-mono text-[var(--text-secondary)] mb-1">X₁</label>
                    <input
                      type="number"
                      id="tp-x1"
                      step="any"
                      value="0"
                      class="calc-input w-full border border-[var(--border-structural)] bg-[var(--surface-card)] px-2.5 py-1.5 text-xs font-mono text-[var(--text-primary)] focus:outline-none"
                      placeholder="0"
                    />
                  </div>
                  <div>
                    <label for="tp-y1" class="block text-[10px] font-mono text-[var(--text-secondary)] mb-1">Y₁</label>
                    <input
                      type="number"
                      id="tp-y1"
                      step="any"
                      value="0"
                      class="calc-input w-full border border-[var(--border-structural)] bg-[var(--surface-card)] px-2.5 py-1.5 text-xs font-mono text-[var(--text-primary)] focus:outline-none"
                      placeholder="0"
                    />
                  </div>
                </div>
              </div>

              <!-- Point 2 (X2, Y2) -->
              <div class="border border-[var(--border-structural)] p-3 bg-[var(--surface-muted)] space-y-2">
                <div class="text-[11px] font-mono font-semibold text-[var(--text-primary)]">
                  POINT 2 (P₂)
                </div>
                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label for="tp-x2" class="block text-[10px] font-mono text-[var(--text-secondary)] mb-1">X₂</label>
                    <input
                      type="number"
                      id="tp-x2"
                      step="any"
                      value="4"
                      class="calc-input w-full border border-[var(--border-structural)] bg-[var(--surface-card)] px-2.5 py-1.5 text-xs font-mono text-[var(--text-primary)] focus:outline-none"
                      placeholder="4"
                    />
                  </div>
                  <div>
                    <label for="tp-y2" class="block text-[10px] font-mono text-[var(--text-secondary)] mb-1">Y₂</label>
                    <input
                      type="number"
                      id="tp-y2"
                      step="any"
                      value="4"
                      class="calc-input w-full border border-[var(--border-structural)] bg-[var(--surface-card)] px-2.5 py-1.5 text-xs font-mono text-[var(--text-primary)] focus:outline-none"
                      placeholder="4"
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Mode A Output Cards -->
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-[var(--text-primary)]">
                Computation Outputs
              </span>
              <button
                type="button"
                class="copy-summary-btn text-[11px] font-mono px-2 py-0.5 border border-[var(--border-structural)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--text-primary)] transition-colors flex items-center gap-1"
                aria-label="Copy all calculation results"
              >
                <span>COPY SUMMARY</span>
              </button>
            </div>

            <!-- Direction Banner -->
            <div class="border border-[var(--border-structural)] bg-[var(--surface-muted)] px-3 py-2 text-xs font-mono flex items-center justify-between">
              <span class="text-[var(--text-secondary)]">TRAJECTORY:</span>
              <span id="tp-result-dir" class="font-semibold text-[var(--text-primary)]">Upward slope (Ascending)</span>
            </div>

            <!-- Metric Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono">
              <!-- Slope -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Slope (m) = Δy / Δx</div>
                  <div id="tp-result-slope" class="text-sm font-bold text-[var(--text-primary)]">1</div>
                </div>
                <button
                  type="button"
                  data-copy-target="tp-result-slope"
                  data-copy-label="Slope"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy slope value"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>

              <!-- Percentage Grade -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Percentage Grade (%)</div>
                  <div id="tp-result-grade" class="text-sm font-bold text-[var(--text-primary)]">100%</div>
                </div>
                <button
                  type="button"
                  data-copy-target="tp-result-grade"
                  data-copy-label="Percentage grade"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy percentage grade"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>

              <!-- Angle Degrees -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Angle θ (Degrees)</div>
                  <div id="tp-result-deg" class="text-sm font-bold text-[var(--text-primary)]">45°</div>
                </div>
                <button
                  type="button"
                  data-copy-target="tp-result-deg"
                  data-copy-label="Angle in degrees"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy angle in degrees"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>

              <!-- Angle Radians -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Angle θ (Radians)</div>
                  <div id="tp-result-rad" class="text-sm font-bold text-[var(--text-primary)]">0.7854 rad</div>
                </div>
                <button
                  type="button"
                  data-copy-target="tp-result-rad"
                  data-copy-label="Angle in radians"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy angle in radians"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>

              <!-- Equation of Line -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Linear Equation (y = mx + b)</div>
                  <div id="tp-result-eq" class="text-sm font-bold text-[var(--text-primary)]">y = x</div>
                </div>
                <button
                  type="button"
                  data-copy-target="tp-result-eq"
                  data-copy-label="Linear equation"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy linear equation"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>

              <!-- Euclidean Distance -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Euclidean Distance (d)</div>
                  <div id="tp-result-dist" class="text-sm font-bold text-[var(--text-primary)]">5.6569</div>
                </div>
                <button
                  type="button"
                  data-copy-target="tp-result-dist"
                  data-copy-label="Euclidean distance"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy distance"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>
            </div>

            <!-- Horizontal / Vertical Changes -->
            <div class="grid grid-cols-2 gap-2 text-xs font-mono pt-1">
              <div class="border border-[var(--border-structural)] px-3 py-2 bg-[var(--surface-muted)] flex justify-between">
                <span class="text-[var(--text-secondary)]">Run (Δx = x₂ - x₁):</span>
                <span id="tp-result-dx" class="font-semibold text-[var(--text-primary)]">4</span>
              </div>
              <div class="border border-[var(--border-structural)] px-3 py-2 bg-[var(--surface-muted)] flex justify-between">
                <span class="text-[var(--text-secondary)]">Rise (Δy = y₂ - y₁):</span>
                <span id="tp-result-dy" class="font-semibold text-[var(--text-primary)]">4</span>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB PANEL 2: RISE & RUN -->
        <div
          id="panel-rr"
          role="tabpanel"
          aria-labelledby="tab-rr"
          class="hidden space-y-6"
        >
          <div>
            <h3 class="text-xs font-mono uppercase tracking-wider text-[var(--text-secondary)] mb-3">
              Rise, Run & Independent Unit Normalization
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Rise Input + Unit -->
              <div class="border border-[var(--border-structural)] p-3 bg-[var(--surface-muted)] space-y-2">
                <div class="text-[11px] font-mono font-semibold text-[var(--text-primary)]">
                  VERTICAL RISE
                </div>
                <div class="flex gap-2">
                  <div class="flex-1">
                    <label for="rr-rise" class="block text-[10px] font-mono text-[var(--text-secondary)] mb-1">Rise Value</label>
                    <input
                      type="number"
                      id="rr-rise"
                      step="any"
                      value="5"
                      class="calc-input w-full border border-[var(--border-structural)] bg-[var(--surface-card)] px-2.5 py-1.5 text-xs font-mono text-[var(--text-primary)] focus:outline-none"
                      placeholder="5"
                    />
                  </div>
                  <div class="w-28">
                    <label for="rr-rise-unit" class="block text-[10px] font-mono text-[var(--text-secondary)] mb-1">Unit</label>
                    <select
                      id="rr-rise-unit"
                      class="calc-input w-full border border-[var(--border-structural)] bg-[var(--surface-card)] px-2 py-1.5 text-xs font-mono text-[var(--text-primary)] focus:outline-none"
                    >
                      <option value="in">Inches (in)</option>
                      <option value="ft">Feet (ft)</option>
                      <option value="yd">Yards (yd)</option>
                      <option value="mm">Millimeters (mm)</option>
                      <option value="cm">Centimeters (cm)</option>
                      <option value="m" selected>Meters (m)</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Run Input + Unit -->
              <div class="border border-[var(--border-structural)] p-3 bg-[var(--surface-muted)] space-y-2">
                <div class="text-[11px] font-mono font-semibold text-[var(--text-primary)]">
                  HORIZONTAL RUN
                </div>
                <div class="flex gap-2">
                  <div class="flex-1">
                    <label for="rr-run" class="block text-[10px] font-mono text-[var(--text-secondary)] mb-1">Run Value</label>
                    <input
                      type="number"
                      id="rr-run"
                      step="any"
                      value="10"
                      class="calc-input w-full border border-[var(--border-structural)] bg-[var(--surface-card)] px-2.5 py-1.5 text-xs font-mono text-[var(--text-primary)] focus:outline-none"
                      placeholder="10"
                    />
                  </div>
                  <div class="w-28">
                    <label for="rr-run-unit" class="block text-[10px] font-mono text-[var(--text-secondary)] mb-1">Unit</label>
                    <select
                      id="rr-run-unit"
                      class="calc-input w-full border border-[var(--border-structural)] bg-[var(--surface-card)] px-2 py-1.5 text-xs font-mono text-[var(--text-primary)] focus:outline-none"
                    >
                      <option value="in">Inches (in)</option>
                      <option value="ft">Feet (ft)</option>
                      <option value="yd">Yards (yd)</option>
                      <option value="mm">Millimeters (mm)</option>
                      <option value="cm">Centimeters (cm)</option>
                      <option value="m" selected>Meters (m)</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Mode B Outputs -->
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-[var(--text-primary)]">
                Rise / Run Outputs
              </span>
              <button
                type="button"
                class="copy-summary-btn text-[11px] font-mono px-2 py-0.5 border border-[var(--border-structural)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--text-primary)] transition-colors flex items-center gap-1"
                aria-label="Copy all calculation results"
              >
                <span>COPY SUMMARY</span>
              </button>
            </div>

            <!-- Direction Banner -->
            <div class="border border-[var(--border-structural)] bg-[var(--surface-muted)] px-3 py-2 text-xs font-mono flex items-center justify-between">
              <span class="text-[var(--text-secondary)]">TRAJECTORY:</span>
              <span id="rr-result-dir" class="font-semibold text-[var(--text-primary)]">Upward slope (Ascending)</span>
            </div>

            <!-- Metrics Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono">
              <!-- Slope -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Slope (m) = Rise / Run</div>
                  <div id="rr-result-slope" class="text-sm font-bold text-[var(--text-primary)]">0.5</div>
                </div>
                <button
                  type="button"
                  data-copy-target="rr-result-slope"
                  data-copy-label="Slope"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy slope value"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>

              <!-- Percentage Grade -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Percentage Grade (%)</div>
                  <div id="rr-result-grade" class="text-sm font-bold text-[var(--text-primary)]">50%</div>
                </div>
                <button
                  type="button"
                  data-copy-target="rr-result-grade"
                  data-copy-label="Percentage grade"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy percentage grade"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>

              <!-- Angle Degrees -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Angle θ (Degrees)</div>
                  <div id="rr-result-deg" class="text-sm font-bold text-[var(--text-primary)]">26.5651°</div>
                </div>
                <button
                  type="button"
                  data-copy-target="rr-result-deg"
                  data-copy-label="Angle in degrees"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy angle in degrees"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>

              <!-- Angle Radians -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Angle θ (Radians)</div>
                  <div id="rr-result-rad" class="text-sm font-bold text-[var(--text-primary)]">0.4636 rad</div>
                </div>
                <button
                  type="button"
                  data-copy-target="rr-result-rad"
                  data-copy-label="Angle in radians"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy angle in radians"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>

              <!-- Ratio representation -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Slope Ratio (Pitch)</div>
                  <div id="rr-result-ratio" class="text-sm font-bold text-[var(--text-primary)]">1 : 2</div>
                </div>
                <button
                  type="button"
                  data-copy-target="rr-result-ratio"
                  data-copy-label="Slope ratio"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy slope ratio"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>

              <!-- Slope Length / Hypotenuse -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Hypotenuse Length</div>
                  <div id="rr-result-hyp" class="text-sm font-bold text-[var(--text-primary)]">11.1803 m</div>
                </div>
                <button
                  type="button"
                  data-copy-target="rr-result-hyp"
                  data-copy-label="Hypotenuse"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy hypotenuse"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB PANEL 3: ANGLE / GRADE TO SLOPE -->
        <div
          id="panel-ag"
          role="tabpanel"
          aria-labelledby="tab-ag"
          class="hidden space-y-6"
        >
          <div>
            <h3 class="text-xs font-mono uppercase tracking-wider text-[var(--text-secondary)] mb-3">
              Angular Pitch or Grade Conversion
            </h3>
            <div class="border border-[var(--border-structural)] p-3 bg-[var(--surface-muted)] space-y-3">
              <!-- Mode Selection Radio -->
              <div class="flex items-center gap-4 text-xs font-mono">
                <label class="flex items-center gap-1.5 cursor-pointer">
                  <input
                    type="radio"
                    name="ag-mode"
                    value="angle"
                    checked
                    class="text-[var(--text-primary)] focus:ring-0"
                  />
                  <span>Angle in Degrees (°)</span>
                </label>
                <label class="flex items-center gap-1.5 cursor-pointer">
                  <input
                    type="radio"
                    name="ag-mode"
                    value="grade"
                    class="text-[var(--text-primary)] focus:ring-0"
                  />
                  <span>Percentage Grade (%)</span>
                </label>
              </div>

              <div>
                <label for="ag-input" id="ag-input-unit-label" class="block text-[10px] font-mono text-[var(--text-secondary)] mb-1">
                  Degrees (°) [-89.999° to 89.999°]
                </label>
                <input
                  type="number"
                  id="ag-input"
                  step="any"
                  value="45"
                  class="calc-input w-full border border-[var(--border-structural)] bg-[var(--surface-card)] px-2.5 py-1.5 text-xs font-mono text-[var(--text-primary)] focus:outline-none"
                  placeholder="e.g., 45"
                />
              </div>
            </div>
          </div>

          <!-- Mode C Outputs -->
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-[var(--text-primary)]">
                Derived Quantities
              </span>
              <button
                type="button"
                class="copy-summary-btn text-[11px] font-mono px-2 py-0.5 border border-[var(--border-structural)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--text-primary)] transition-colors flex items-center gap-1"
                aria-label="Copy all calculation results"
              >
                <span>COPY SUMMARY</span>
              </button>
            </div>

            <!-- Direction Banner -->
            <div class="border border-[var(--border-structural)] bg-[var(--surface-muted)] px-3 py-2 text-xs font-mono flex items-center justify-between">
              <span class="text-[var(--text-secondary)]">TRAJECTORY:</span>
              <span id="ag-result-dir" class="font-semibold text-[var(--text-primary)]">Upward slope (Ascending)</span>
            </div>

            <!-- Metrics Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono">
              <!-- Slope -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Slope (m) = tan(θ)</div>
                  <div id="ag-result-slope" class="text-sm font-bold text-[var(--text-primary)]">1</div>
                </div>
                <button
                  type="button"
                  data-copy-target="ag-result-slope"
                  data-copy-label="Slope"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy slope value"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>

              <!-- Percentage Grade -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Percentage Grade (%)</div>
                  <div id="ag-result-grade" class="text-sm font-bold text-[var(--text-primary)]">100%</div>
                </div>
                <button
                  type="button"
                  data-copy-target="ag-result-grade"
                  data-copy-label="Percentage grade"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy percentage grade"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>

              <!-- Angle Degrees -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Angle θ (Degrees)</div>
                  <div id="ag-result-deg" class="text-sm font-bold text-[var(--text-primary)]">45°</div>
                </div>
                <button
                  type="button"
                  data-copy-target="ag-result-deg"
                  data-copy-label="Angle in degrees"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy angle in degrees"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>

              <!-- Angle Radians -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Angle θ (Radians)</div>
                  <div id="ag-result-rad" class="text-sm font-bold text-[var(--text-primary)]">0.7854 rad</div>
                </div>
                <button
                  type="button"
                  data-copy-target="ag-result-rad"
                  data-copy-label="Angle in radians"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy angle in radians"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>

              <!-- Normalized Ratio -->
              <div class="border border-[var(--border-structural)] p-2.5 flex items-center justify-between bg-[var(--surface-card)]">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Normalized Ratio</div>
                  <div id="ag-result-ratio" class="text-sm font-bold text-[var(--text-primary)]">1 : 1</div>
                </div>
                <button
                  type="button"
                  data-copy-target="ag-result-ratio"
                  data-copy-label="Normalized ratio"
                  class="p-1 border border-[var(--border-structural)] text-[10px] hover:border-[var(--text-primary)] transition-colors"
                  aria-label="Copy normalized ratio"
                >
                  <span class="copy-text-feedback">COPY</span>
                </button>
              </div>

              <!-- Rise / Run normalized components -->
              <div class="border border-[var(--border-structural)] p-2.5 bg-[var(--surface-card)] flex items-center justify-between">
                <div>
                  <div class="text-[10px] text-[var(--text-secondary)] uppercase">Normalized Vector (Rise / Run)</div>
                  <div class="text-sm font-bold text-[var(--text-primary)]">
                    <span id="ag-result-rise">1</span> / <span id="ag-result-run">1</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Diagram (5 cols on desktop) -->
      <div class="lg:col-span-5 p-4 sm:p-6 bg-[var(--surface-muted)] flex flex-col justify-between">
        <SlopeDiagram />
        
        <!-- Helpful Context Hint -->
        <div class="mt-4 p-3 border border-[var(--border-structural)] bg-[var(--surface-card)] text-[11px] font-mono text-[var(--text-secondary)] leading-relaxed">
          <div class="font-semibold text-[var(--text-primary)] mb-1">
            CARTESIAN METRIC CONVENTIONS:
          </div>
          Vertical lines (Δx = 0) yield undefined slope ($90^\circ$ pitch angle). Horizontal lines (Δy = 0) yield $m = 0$ ($0\%$ grade). Trajectory vectors preserve sign directionality.
        </div>
      </div>
    </div>
  </div>
</section>

