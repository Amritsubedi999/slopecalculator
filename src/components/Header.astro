---
import ThemeSwitcher from './ThemeSwitcher.astro';

const isHome = Astro.url.pathname === '/';
---

<header class="w-full border-b border-[var(--border-structural)] bg-[var(--bg-page)] sticky top-0 z-40 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-4">
    <!-- Brand / Tool Title -->
    <a href="/" class="flex items-center gap-2 text-sm font-mono tracking-tight font-semibold hover:opacity-80 transition-opacity" aria-label="Slope Calculator Home">
      <span class="inline-flex items-center justify-center w-6 h-6 border border-[var(--text-primary)] text-xs font-bold leading-none">
        ⊿
      </span>
      <span class="text-[var(--text-primary)] uppercase tracking-wider text-xs sm:text-sm">
        SLOPE<span class="text-[var(--text-secondary)] font-normal"> // ENGINE</span>
      </span>
    </a>

    <!-- Right Controls: Back to Calculator (when on subpages) + Theme Switcher -->
    <div class="flex items-center gap-3">
      {!isHome && (
        <a
          href="/"
          class="text-xs font-mono text-[var(--text-secondary)] hover:text-[var(--text-primary)] px-2.5 py-1 border border-[var(--border-structural)] bg-[var(--surface-muted)] transition-colors"
        >
          ← Calculator
        </a>
      )}
      <ThemeSwitcher />
    </div>
  </div>
</header>
