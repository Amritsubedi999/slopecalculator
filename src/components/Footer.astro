---
const currentYear = new Date().getFullYear();
const footerLinks = [
  { href: '/about', label: 'About' },
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms of Use' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="w-full border-t border-[var(--border-structural)] bg-[var(--bg-page)] mt-auto text-xs font-mono transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-8 border-b border-[var(--border-structural)]">
      <!-- Col 1: System Identification -->
      <div class="space-y-2">
        <div class="flex items-center gap-2 font-semibold">
          <span class="inline-flex items-center justify-center w-5 h-5 border border-[var(--text-primary)] text-[10px] leading-none">⊿</span>
          <span class="tracking-wider uppercase">SLOPE // CALCULATOR</span>
        </div>
        <p class="text-[var(--text-secondary)] text-[11px] leading-relaxed">
          High-precision utilitarian mathematical tool for civil engineers, surveyors, architects, students, and tradespeople. Zero external tracking, zero server computation.
        </p>
        <div class="text-[10px] text-[var(--text-secondary)]">
          EXECUTION: CLIENT_SIDE // IEEE-754 64-BIT FLOAT
        </div>
      </div>

      <!-- Col 2: Navigation Links in the bottom -->
      <div class="space-y-2">
        <div class="font-semibold text-[var(--text-primary)] uppercase tracking-wider text-[11px]">
          Documentation & Legal
        </div>
        <ul class="space-y-2">
          {footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] underline decoration-[var(--border-structural)] hover:decoration-[var(--text-primary)] transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Engineering Disclaimer -->
      <div class="space-y-2">
        <div class="font-semibold text-[var(--text-primary)] uppercase tracking-wider text-[11px]">
          Engineering Verification Notice
        </div>
        <p class="text-[var(--text-secondary)] text-[11px] leading-relaxed">
          Calculations are computed deterministically per standard Cartesian geometry and trigonometric identities. For structural load calculations, ADA ramp compliance, and road design, verify figures against local jurisdiction building codes.
        </p>
      </div>
    </div>

    <!-- Bottom metadata bar -->
    <div class="pt-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-[11px] text-[var(--text-secondary)]">
      <div>
        © {currentYear} SLOPE CALCULATOR. MIT OPEN SOURCE SPECIFICATION.
      </div>
      <div class="flex items-center gap-4">
        <span>STATUS: OPERATIONAL</span>
        <span>STANDARDS: W3C / ADA / IBC</span>
      </div>
    </div>
  </div>
</footer>
