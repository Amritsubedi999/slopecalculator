---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "404 Not Found // Slope Calculator";
const description = "The requested coordinate or path does not exist. Return to the Slope Calculator main interface.";
---

<BaseLayout title={title} description={description}>
  <div class="max-w-2xl mx-auto py-16 text-center space-y-6 font-mono">
    <div class="inline-flex items-center justify-center w-16 h-16 border-2 border-[var(--text-primary)] text-2xl font-bold">
      404
    </div>
    
    <div class="space-y-2">
      <h1 class="text-xl font-bold uppercase tracking-tight text-[var(--text-primary)]">
        Vector Path Not Located
      </h1>
      <p class="text-xs text-[var(--text-secondary)] max-w-md mx-auto leading-relaxed">
        The coordinate route you requested does not correspond to any valid endpoint in this mathematical system.
      </p>
    </div>

    <div class="border border-[var(--border-structural)] bg-[var(--surface-muted)] p-4 text-[11px] max-w-md mx-auto text-left space-y-1">
      <div>STATUS: HTTP 404 NOT_FOUND</div>
      <div>DIAGNOSIS: NULL_ROUTE_EXCEPTION</div>
      <div>ACTION: RETURN_TO_ORIGIN (0, 0)</div>
    </div>

    <div>
      <a
        href="/"
        class="inline-block border border-[var(--text-primary)] bg-[var(--text-primary)] text-[var(--bg-page)] px-6 py-2.5 text-xs font-bold uppercase tracking-wider hover:opacity-90 transition-opacity"
      >
        Return to Calculator
      </a>
    </div>
  </div>
</BaseLayout>
